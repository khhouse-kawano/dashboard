{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    // ⚠️ SDK が "type": "module" の ESM 専用パッケージなので、
    //   こちらも ESM で出力する。CommonJS にすると import できない。
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
