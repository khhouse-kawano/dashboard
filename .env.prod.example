# =============================================================
# 本番（VPS）用の環境変数の雛形。
#
#   cp .env.prod.example .env.prod   してから値を埋める。
#   .env.prod は .gitignore の **/.env* で除外済み。
#
# 起動:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# =============================================================

# --- PHP互換ゲートウェイ -----------------------------------------------
# 既存フロントの通信形式（1つのURLへのPOST）をそのまま受ける入口。
# Express へ移植済みのものは Express が処理し、未移植は下のURLへ転送する。
#
# ⚠️ 転送先は「① レンタルサーバー」のゲートウェイURL。
#   ② VPS 自身のURL（api.khg-marketing.info）を書くと無限ループになる。
#
# 移植が完了して転送が不要になったら空にする。
PHP_GATEWAY_URL=https://khg-marketing.info/dashboard/api/gateway/
PHP_GATEWAY_TIMEOUT_MS=120000

# 移植済みエンドポイントに Token 認証を要求するか。
# ⚠️ 現状のPHPは Authorization ヘッダを検証していないため、
#   true にすると Express 側だけ厳しくなり、Token を送らない画面が 401 になる。
#   移植と認証強化は分けて進めるので、まずは false のままにする。
GATEWAY_REQUIRE_AUTH=false

# ブラウザからゲートウェイを叩く場合に必要（カンマ区切り）。
# ⚠️ 空のままだと全リクエストがCORSでブロックされ、画面が真っ白になる。
#   分析API（MCPサーバー）だけを使う段階では空でよい。
#
# ⚠️ **公開ギャラリーは別ドメイン（https://k-snap.jp）である。**
#   フロントを ② へ直接向けるときは、ダッシュボードだけでなく
#   k-snap.jp も許可しないと顧客側が止まる。
#   現状は ① の core/db.php が `Access-Control-Allow-Origin: *` を返すため
#   ① 経由なら問題ない。
#
# ⚠️⚠️ **https://kh-house.jp はアンバサダー反響フォームの置き場所である。**
#   （https://kh-house.jp/ambassador/ … request: 'ambassador_inquiry'）
#   これは ① を経由せず ② を**直接**叩くため、ここから外すと
#   **反響が1件も届かなくなる。**
#   顧客側にはブラウザのCORSエラーしか出ず、社内では何も起きないため、
#   止まっていることに誰も気づけない。
#
# ⚠️ CORS はブラウザの仕組みであり、curl には効かない。
#   ここに書いたドメイン「だけ」が送れる、という防御にはならない。
#   公開受付の実際の防御は流量制限と入力検証のほう（registry.ts のコメント参照）。
CORS_ORIGINS=https://khg-marketing.info,https://k-snap.jp,https://kh-house.jp

# --- K-SNAP ------------------------------------------------------------
# 公開ギャラリーに返す owner（オーナー名）を暗号化する鍵。
#
# ⚠️ ① レンタルサーバーの .htaccess（SetEnv KSNAP_OWNER_KEY ...）と
#   **必ず同じ値**にすること。異なると暗号文が変わり、
#   owner による絞り込みが ① 経由と ② 経由で食い違う。
#
# ⚠️ 値を変えると既存の暗号文とも一致しなくなり、公開ギャラリーの
#   絞り込みが壊れる。移設のときは値を変えずに持ち越すこと。
#
# ⚠️ 未設定だと owner は空文字になる（平文は返さない）。
KSNAP_OWNER_KEY=
KSNAP_OWNER_IV=

# --- TLS ---------------------------------------------------------------
# Let's Encrypt からの失効通知・取得失敗の連絡先。
# 受信できるアドレスにすること（証明書が切れると全リクエストが止まる）
ACME_EMAIL=

# =============================================================
# ⚠️ 以下すべて「① レンタルサーバー」の情報である。
#
#   ① レンタルサーバー … エックスサーバー（共用）。本番DBがある側。
#                         管理画面は「サーバーパネル」。サーバーIDがある。
#   ② VPS            … Xserver VPS（162.43.5.127）。このファイルを置く側。
#                         管理画面は「VPSパネル」。サーバーIDは無い。
#
#   ② VPS 自身へのログイン情報（SSH-A）はここには書かない。
# =============================================================

# --- ② VPS から ① レンタルサーバーへのSSH接続（SSH-B）------------------
# 先に ② VPS 上で鍵を作り、公開鍵を ① のサーバーパネル「SSH設定」に
# 登録しておくこと（作る場所と登録する場所が別サーバー）。
#
# SSH_HOST … ① のサーバーパネルに表示されるホスト名。例: svXXXX.xserver.jp
# SSH_USER … ① のサーバーID（FTPのユーザー名と同じもの）
SSH_HOST=
SSH_PORT=10022
SSH_USER=

# --- ① レンタルサーバーのMySQL（トンネルの向こう側）--------------------
#
# ⚠️ ここは「① レンタルサーバーから見たMySQLのホスト名」を書く。
#   ssh -L 3306:REMOTE_DB_HOST:3306 の REMOTE_DB_HOST は、
#   ② VPS ではなく ① の内部で名前解決される。
#
#   ① の MySQL は同一サーバー上にあるため localhost で到達する
#   （① 上の .htaccess も DB_HOST=localhost:3306 で動いている）。
#   サーバーパネルに「MySQLホスト名」の項目が無いのはそのため。
REMOTE_DB_HOST=localhost
REMOTE_DB_PORT=3306

# データベース名とユーザー。① のサーバーパネル「MySQL設定」で確認する。
# ⚠️ 分析APIは集計しか行わないため、SELECT だけを持つ専用ユーザーを
#   使うこと。書き込み権限のあるユーザーを設定してはならない。
#   （① のサーバーパネルで権限を絞れるかは要確認。絞れない場合は
#     この点をリスクとして受け入れるか、別の手段を検討すること）
DB_NAME=
DB_USER=
DB_PASS=

# --- メール送信（アンバサダー反響）------------------------------------
#
# ⚠️ ① レンタルサーバーのメールアカウントで認証して送る。
#   ② から自前の名前で送ると送信ドメインの SPF / DKIM と合わず、
#   ほぼ確実に迷惑メール扱いになる。
#
# ⚠️ **未設定なら送信をスキップする（起動は止まらない）。**
#   「反響は保存されるがメールだけ来ない」状態に気づきにくいので、
#   デプロイ後に必ずテスト送信で確認すること。
#
# ⚠️⚠️ **送信元は khg-marketing.info（① レンタルサーバー）にすること。**
#   kh-house.jp から送ってはいけない。理由は2つあり、どちらも実際に起きた。
#
#   1. **宛先に届かない。**
#      kh-house.jp のメールは MX がさくら + Google Workspace を向いており、
#      Xserver では受信していない。それなのに Xserver 上に
#      noreply@kh-house.jp を作ると、Xserver は「kh-house.jp は自分の
#      ドメインだ」と判断し、mkt@kh-house.jp 宛を **MXを見ずに内部配送**する。
#      さくらにも Google にも届かず、エラーも出ない。
#      ⚠️ これは**差出人ではなく宛先ドメインで決まる**ため、
#        From を変えるだけでは直らない。送信サーバーごと変える必要がある。
#
#   2. **SPF に通らない。**
#      kh-house.jp の SPF に Xserver が含まれていない（~all なので
#      配送はされるが迷惑メール扱いになる）。
#      khg-marketing.info の SPF は
#        v=spf1 +a:sv13020.xserver.jp +a:khg-marketing.info +mx
#               include:spf.sender.xserver.jp ~all
#      であり、① から送れば正規の送信元として認証される。
#
# ⚠️ SMTP_HOST は ① のサーバーパネル「メールソフト設定」に出る名前。
#   sv11135.xbiz.ne.jp（Xserver ビジネス／kh-house.jp 側）とは**別のサーバー**。
#   取り違えると上記1の状態に戻る。
#
# SMTP_PORT … 465（SSL）または 587（STARTTLS）。
#             ⚠️ secure はポートから自動判定する。465 以外は STARTTLS 扱い。
# SMTP_USER … メールアドレスそのもの
SMTP_HOST=sv13020.xserver.jp
SMTP_PORT=465
SMTP_USER=noreply@khg-marketing.info
SMTP_PASS=

# 差出人。⚠️ SMTP_USER と同じアドレスにすること。
#   別のアドレスにすると送信を拒否されるか、なりすまし判定される。
#
# ⚠️ 表示名は「国分ハウジング」にしておく。顧客の受信箱で
#   ドメイン名（khg-marketing.info）だけが見えると差出人が分からない。
SMTP_FROM=国分ハウジング <noreply@khg-marketing.info>

# 顧客が返信したときの宛先。
# ⚠️ noreply から送るため、これが無いと返信が誰にも届かない。
MAIL_REPLY_TO=mkt@kh-house.jp

# 反響の社内通知先。カンマ区切りで複数可。
# ⚠️ ここが空だと社内通知が飛ばず、ダッシュボードを見るまで反響に気づけない。
AMBASSADOR_NOTIFY_TO=mkt@kh-house.jp
