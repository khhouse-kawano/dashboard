# =============================================================
# 分析APIの入口。TLS終端とリバースプロキシ。
#
# Caddy を選んだ理由
#   Let's Encrypt の証明書取得と更新を自動でやる。nginx + certbot だと
#   更新の cron を別に用意することになり、失敗に気づきにくい。
#
# ⚠️ このファイルが唯一の公開面になる。
#   express-api の 3001番はホストにもインターネットにも公開しない
#   （docker-compose.prod.yml で ports を書かない）。
# =============================================================

{
	# 証明書の失効通知や取得失敗の連絡先。実在するアドレスにすること
	email {$ACME_EMAIL}

	# サーバー種別を隠す
	servers {
		protocols h1 h2
	}
}

api.khg-marketing.info {
	# --- ログ ---------------------------------------------------------
	#
	# ⚠️⚠️ **認証情報をログに残さないこと。**
	#
	#   Caddy は `Authorization` / `Cookie` / `Set-Cookie` /
	#   `Proxy-Authorization` を**既定で REDACTED にする**。
	#   しかしダッシュボードは独自の **`Token` ヘッダ**（staff.api_token）を
	#   使っており、既定の対象外だった。
	#
	#   ⚠️ そのため 2026-09-10 まで、アクセスログに
	#     "Token":["0697bc8d…（64文字）"]
	#   という形で**スタッフの認証キーが平文で記録されていた**。
	#   これがあればパスワード無しで本番データを読める。
	#
	#   ⚠️ 保持量は roll_size 10MiB × roll_keep 10 = 最大100MiB。
	#     気づかないまま蓄積する。
	#
	# ⚠️ ヘッダを増やすときは、認証情報かどうかを必ず確認し、
	#   該当するならこの fields に追記すること。
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 10
		}

		# ⚠️ `filter` は json を包む形で書く。`format json` と併記しないこと
		#   （後に書いたほうが勝ち、フィルタが無効になる）。
		format filter {
			wrap json

			fields {
				# ⚠️ これが今回の本題。REDACTED ではなく delete で丸ごと消す
				request>headers>Token delete

				# ⚠️ 既定でも REDACTED になるが、明示しておく。
				#   将来 wrap を別のエンコーダに変えたときの保険。
				request>headers>Authorization delete
				request>headers>Cookie delete
			}
		}
	}

	# --- セキュリティヘッダ -------------------------------------------
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# APIサーバーなので、ブラウザからフレームに埋める用途は無い
		X-Frame-Options "DENY"
		# 使用技術を隠す
		-Server
	}

	# --- 転送先 -------------------------------------------------------
	# express-api はDockerの内部ネットワークにしか居ない。
	reverse_proxy express-api:3001 {
		# Express 側で req.ip を正しく取るために必要。
		# あわせて express-api の TRUST_PROXY=1 を設定すること。
		# ここを揃えないと、レート制限も監査ログのIPも
		# すべて Caddy のIPになって意味を成さなくなる。
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}

		# 重い集計クエリを見込んで長めに取る。
		# Express 側の REQUEST_TIMEOUT_MS より少し長くしておくと、
		# タイムアウト時に Express が返すJSONのエラーがそのまま届く。
		transport http {
			read_timeout 180s
		}
	}
}
