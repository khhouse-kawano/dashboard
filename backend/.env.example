# backend/.env のテンプレート
#
# 使い方:
#   1. このファイルを同じディレクトリに .env という名前でコピーする
#   2. 各値を実際のものに書き換える
#   3. パーミッションを 600 にする（他ユーザーから読めないように）
#        chmod 600 .env
#
# 置き場所:
#   必ず **公開ディレクトリ（src/）の外** に置くこと。
#   src/.env に置くと https://.../.env でブラウザから読めてしまう。
#
# 注意:
#   .env は .gitignore で除外されているため、Git では本番に運ばれない。
#   デプロイ時に手動で配置する必要がある。
#
# なお、本番(XServer)では .htaccess の SetEnv でも同じことができる。
#   SetEnv APP_ENCRYPTION_KEY xxxxx
#   SetEnv APP_KEY_VERSION 1
#   どちらか一方でよい。両方ある場合は SetEnv が優先される。


# ─────────────────────────────────────────────
# 暗号化マスターキー（APIキーの暗号化・復号に使用）
# ─────────────────────────────────────────────
#
# 生成方法:
#   docker compose exec php-web php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
#
# ⚠️ この値を紛失すると、api_credential に保存済みの全APIキーが
#    復号不能になり、再登録が必要になる。
# ⚠️ この値が漏れると、保存済みの全APIキーが復号可能になる。
#    DBのダンプとは必ず別の場所で管理すること。
#
APP_ENCRYPTION_KEY=ここにbase64された32バイトの文字列

# マスターキーの世代。交換時に 2, 3 と増やす。
# 世代2以降は APP_ENCRYPTION_KEY_V2 のように参照される。
APP_KEY_VERSION=1


# ─────────────────────────────────────────────
# データベース接続
# ─────────────────────────────────────────────
#
# ローカル(Docker)では docker-compose.yml の environment が設定するため、
# ここに書く必要はない。
# 本番では .htaccess の SetEnv で設定済みであれば、こちらも不要。
#
# DB_HOST=
# DB_NAME=
# DB_USER=
# DB_PASS=
