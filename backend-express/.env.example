# backend-express の環境変数の雛形。
#
# このファイルをコピーして .env を作り、値を埋めること。
#   cp .env.example .env
#
# .env は .gitignore で除外済み。秘密情報を書いてよいのはこちらだけで、
# リポジトリ直下の .env / .env.development / .env.production は
# 追跡済みのためコミットされてしまう。絶対に書かないこと。
#
# 読み込みは Node 20 以降の標準機能を使う（dotenv は入れていない）:
#   node --env-file=.env scripts/xxx.mjs

# --- データベース -----------------------------------------------------------
# 既定値は docker-compose.yml のローカル開発用と同じ。
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=local_db
DB_USER=local_user
DB_PASS=

# --- e-Stat API -------------------------------------------------------------
# 政府統計の総合窓口(e-Stat)のアプリケーションID。
# 人口・世帯数・建築着工の経年データを取り込むスクリプトが使う。
# https://www.e-stat.go.jp/api/ で払い出す。
ESTAT_APP_ID=

# --- Supabase 移行スクリプト（既存）-----------------------------------------
SUPABASE_URL=
SUPABASE_KEY=
