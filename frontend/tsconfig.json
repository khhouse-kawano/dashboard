{
  "include": ["src"],
  "exclude": ["src/components/test.js"],
  "compilerOptions": {
    "jsx": "react",
    "typeRoots": ["./src/types", "./node_modules/@types"],
    "noImplicitAny": false,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  }
}
